      #!/usr/bin/env python3
      import sys
      import json
      import urllib.parse

      try:
          from flask import Flask, request, render_template, jsonify
          import requests
          USE_FLASK = True
      except ImportError:
          USE_FLASK = False
          import urllib.request
          from http.server import HTTPServer, BaseHTTPRequestHandler

      if USE_FLASK:
          app = Flask(__name__)

          @app.route('/')
          def home():
              return render_template('index.html')

          @app.route('/fetch', methods=['GET'])
          def fetch():
              url = request.args.get('url', '')
              if not url:
                  return {'error': 'URL parameter missing'}, 400
              if not url.startswith('http'):
                  return {'error': 'Invalid URL'}, 400

              try:
                  response = requests.get(url, timeout=5)
                  return {
                      'url': url,
                      'status': response.status_code,
                      'content': response.text[:500]
                  }
              except Exception as e:
                  return {'url': url, 'error': str(e)}, 500

          @app.route('/admin', methods=['GET', 'POST'])
          def admin():
              return {'message': "This endpoint doesn't do anything yet"}

          if __name__ == '__main__':
              app.run(host='0.0.0.0', port=3000, debug=False)
      else:
          import os
          from pathlib import Path
          HTML_FILE = Path(__file__).parent / "templates" / "index.html"

          class EntryHandler(BaseHTTPRequestHandler):
              def do_GET(self):
                  parsed = urllib.parse.urlparse(self.path)
                  if parsed.path == '/' or parsed.path == '/index.html':
                      if HTML_FILE.exists():
                          content = HTML_FILE.read_bytes()
                      else:
                          content = b"<h1>NexaCorp URL Fetcher</h1>"
                      self.send_response(200)
                      self.send_header('Content-Type', 'text/html; charset=utf-8')
                      self.end_headers()
                      self.wfile.write(content)
                  elif parsed.path == '/fetch':
                      qs = urllib.parse.parse_qs(parsed.query)
                      url = qs.get('url', [''])[0]
                      if not url:
                          self._send_json({'error': 'URL parameter missing'}, status=400)
                          return
                      if not url.startswith('http'):
                          self._send_json({'error': 'Invalid URL'}, status=400)
                          return
                      try:
                          req = urllib.request.Request(url, headers={'User-Agent': 'NexaCorp-Fetcher/1.0'})
                          with urllib.request.urlopen(req, timeout=5) as resp:
                              content = resp.read(500).decode('utf-8', errors='replace')
                              self._send_json({'url': url, 'status': resp.status, 'content': content})
                      except Exception as e:
                          self._send_json({'url': url, 'error': str(e)}, status=500)
                  elif parsed.path == '/admin':
                      self._send_json({'message': "This endpoint doesn't do anything yet"})
                  else:
                      self.send_response(404)
                      self.end_headers()

              def _send_json(self, data, status=200):
                  payload = json.dumps(data).encode('utf-8')
                  self.send_response(status)
                  self.send_header('Content-Type', 'application/json')
                  self.end_headers()
                  self.wfile.write(payload)

              def log_message(self, format, *args):
                  pass

          server = HTTPServer(('0.0.0.0', 3000), EntryHandler)
          server.serve_forever()

